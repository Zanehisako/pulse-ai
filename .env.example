
# PostgreSQL
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=unsafe-local-dev-secret-key
DB_USER=admin
DB_PASSWORD=admin
POSTGRES_PASSWORD=admin
DB_NAME=pios
DB_HOST=localhost
DB_PORT=5432

# SonarQube
SONAR_ADMIN_PASSWORD=
SONAR_TOKEN=
# mlflow
MLFLOW_TRACKING_URI=http://localhost:8889

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Keycloak (local mode)
KEYCLOAK_SERVER_URL=http://localhost:8080/
KEYCLOAK_REALM_NAME=pios
KEYCLOAK_CLIENT_ID=django-backend
KEYCLOAK_CLIENT_SECRET=

# Keycloak master admin used only for local bootstrap/admin API operations.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Demo application user verified by start-local.sh.
KEYCLOAK_APP_USERNAME=pios
KEYCLOAK_APP_PASSWORD=pios
KEYCLOAK_APP_EMAIL=pios@example.com
SKIP_KEYCLOAK_BOOTSTRAP=false

# API docs local auto-auth. Debug mode only; returns access_token, never refresh_token.
PIOS_API_DOCS_AUTO_AUTH_ENABLED=1
PIOS_API_DOCS_TOKEN_ROUTE=api/docs/auth-token/
PIOS_API_DOCS_SECURITY_SCHEME="Bearer Authentication"
PIOS_API_DOCS_KEYCLOAK_CLIENT_ID=pios-react
PIOS_API_DOCS_KEYCLOAK_CLIENT_SECRET=

# Web app (Vite)
VITE_API_URL=http://localhost:8000
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=pios
VITE_KEYCLOAK_CLIENT_ID=pios-react
