# PulseAI ChatApp Frontend Environment Variables
# Copy to .env or .env.local for local development, or configure in Cloudflare Pages Dashboard:
# Dashboard -> Workers & Pages -> <project> -> Settings -> Variables and Secrets -> Environment Variables

# Backend API Base URL (leave empty when using local Vite dev proxy or Cloudflare Pages rewrite proxy)
# Production example: https://api.pulse-ai.org
VITE_API_BASE_URL=

# WebSocket Base URL (optional; automatically derived from VITE_API_BASE_URL with ws:// / wss:// if omitted)
# Production example: wss://api.pulse-ai.org
VITE_WS_BASE_URL=

# Default Model Display Name Fallback
VITE_DEFAULT_MODEL=PulseAI Orchestrator
