          "task_type": "classification",
          "clip_min": 0.0,
          "clip_max": 1.0,
          "apply_clipping": true
        }
      }
    },
    "donor_priority_policy_model": {
      "metadata": {
        "description": "Expected-utility donor priority policy for constrained outreach ranking.",
        "task": "donor_individual"
      },
      "defaults": {
        "prediction_source": "direct_input",
        "output": {
          "name": "donor_priority_score",
