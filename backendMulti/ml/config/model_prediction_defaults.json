{
  "models": {
    "donor_next_donation_hazard_model": {
      "metadata": {
        "description": "Discrete-time recurrent-style donor hazard model for next usable donation timing.",
        "task": "donor_horizon"
      },
      "defaults": {
        "prediction_source": "direct_input",
        "forecast_selection": {
          "enabled": true,
          "target": "donation",
          "primary_metric": "brier_score",
          "direction": "minimize",
          "fallback_metrics": ["log_loss", "average_precision", "roc_auc"]
        },
        "horizon_routing": {
          "enabled": true,
          "timeframes": ["short", "medium", "long"],
          "min_days": 0,
          "max_days": 365,
          "priority": 150,
          "target": "donation"
        },
        "feast": {
          "feature_service": "quebec_donor_service",
          "entity_keys": ["donor_id"],
          "allow_direct_input": true,
          "allow_feature_overrides": true,
          "fail_open": true
        },
        "output": {
          "name": "donation_probability",
          "unit": "probability",
          "task_type": "survival_hazard",
          "clip_min": 0.0,
          "clip_max": 1.0,
          "apply_clipping": true
        }
      }
    },
    "ideal_donor_probability_model": {
      "metadata": {
        "description": "Bounded ideal donor probability score for donor profile suitability.",
        "task": "donor_individual"
      },
      "defaults": {
        "prediction_source": "direct_input",
        "output": {
          "name": "ideal_donor_probability",
          "unit": "probability",
          "task_type": "regression",
          "clip_min": 0.0,
          "clip_max": 1.0,
          "apply_clipping": true
        }
      }
    },
    "donor_contact_propensity_model": {
      "metadata": {
        "description": "Proxy donor contact propensity model for engagement likelihood.",
        "task": "donor_individual"
      },
      "defaults": {
        "prediction_source": "direct_input",
        "feast": {
          "feature_service": "quebec_donor_service",
          "entity_keys": ["donor_id"],
          "allow_direct_input": true,
          "allow_feature_overrides": true,
          "fail_open": false
        },
        "output": {
          "name": "contact_propensity",
          "unit": "probability",
          "task_type": "classification",
          "clip_min": 0.0,
          "clip_max": 1.0,
          "apply_clipping": true
        }
      }
    },
    "donor_contact_response_model": {
      "metadata": {
        "description": "Shadow contact-response model using proxy labels until true contact outcomes exist.",
