    "component_inventory_risk_simulator": {
      "metadata": {
        "description": "Primary stockout decision engine: probabilistic demand, supply, waste, and inventory simulation.",
        "task": "inventory_forecast"
      },
      "defaults": {
        "prediction_source": "direct_input",
        "horizon_routing": {
          "enabled": true,
          "timeframes": ["short", "medium", "long"],
          "min_days": 0,
          "max_days": 180,
          "priority": 160,
          "target": "stockout"
        },
        "output": {
          "name": "inventory_risk",
          "unit": "probability_and_days",
          "task_type": "multi_output_probability_and_timing",
          "apply_clipping": true
        },
        "output_contract": {
          "p_stockout_0_7d": {"type": "probability", "clip_min": 0.0, "clip_max": 1.0},
          "p_stockout_0_30d": {"type": "probability", "clip_min": 0.0, "clip_max": 1.0},
          "p_stockout_0_90d": {"type": "probability", "clip_min": 0.0, "clip_max": 1.0},
          "p_stockout_0_180d": {"type": "probability", "clip_min": 0.0, "clip_max": 1.0},
          "p_stockout_0_maxd": {"type": "probability", "clip_min": 0.0, "clip_max": 1.0},
          "expected_days_until_stockout": {"type": "days", "clip_min": 0},
          "p10_days_until_stockout": {"type": "days_or_null", "clip_min": 0},
          "p50_days_until_stockout": {"type": "days_or_null", "clip_min": 0},
          "p90_days_until_stockout": {"type": "days_or_null", "clip_min": 0},
          "median_status": {"type": "string"}
        }
      }
    },
    "donor_uplift_model": {
      "metadata": {
        "description": "Disabled causal uplift placeholder pending randomized outreach holdout data.",
        "task": "donor_individual"
      },
      "defaults": {
        "enabled": false,
        "output": {
          "name": "uplift_score",
          "unit": "probability_delta",
          "task_type": "uplift",
          "clip_min": -1.0,
          "clip_max": 1.0,
          "apply_clipping": true
        }
      }
    }
  }
}
