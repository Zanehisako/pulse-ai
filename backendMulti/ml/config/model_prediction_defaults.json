    },
    "stockout_time_to_event_hazard_model": {
      "metadata": {
        "description": "Stockout hazard sentinel that complements the inventory simulator.",
        "task": "inventory_forecast"
      },
      "defaults": {
        "prediction_source": "direct_input",
        "forecast_selection": {
          "enabled": true,
          "target": "stockout",
          "primary_metric": "brier_score",
          "direction": "minimize",
          "fallback_metrics": ["log_loss", "average_precision", "roc_auc"]
        },
        "horizon_routing": {
          "enabled": true,
          "timeframes": ["short", "medium"],
          "min_days": 0,
          "max_days": 60,
          "priority": 100,
          "target": "stockout"
        },
        "feast": {
          "feature_service": "quebec_arima_sarima_forecast_service",
          "entity_keys": ["hospital_id", "blood_type", "component_type"],
          "optional_entity_keys": ["blood_type", "component_type"],
          "allow_direct_input": true,
          "allow_feature_overrides": true,
          "fail_open": false
        },
        "output": {
          "name": "stockout_probability",
