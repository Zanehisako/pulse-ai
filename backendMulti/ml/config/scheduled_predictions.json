        "run_hospital_shortage_predictions",
        "run_hospital_shortage_predictions_sync",
        "run_dashboard_predictions",
        "run_dashboard_predictions_sync"
      ],
      "enabled": true,
      "deployment_mode": "shadow",
      "dashboard_role": "stockout_risk",
      "description": "Shadow stockout risk predictions from the component inventory simulator.",
      "model_id": "component_inventory_risk_simulator",
      "result_model_name": "component_inventory_risk_simulator_shadow",
      "model_version": "challenger",
      "entity_source": "inventory.tasks.stockout_supply_entities",
      "feature_builder": "inventory.tasks.inventory_risk_feature_frame",
      "feature_mapping": {
        "hospital_id": {"attr": "hospital.hospital_id", "default": ""},
        "blood_type": {"attr": "blood_product_type", "default": ""},
        "component_type": {"value": "RBC"},
        "event_timestamp": {"attr": "event_timestamp"},
        "current_inventory": {"attr": "current_stock_units", "default": 0},
        "usage_today": {"attr": "usage_today", "default": 0},
        "current_stock_units": {"attr": "current_stock_units", "default": 0},
        "units_used": {"attr": "usage_today", "default": 0},
        "units_collected": {"value": 0},
        "wastage": {"value": 0},
        "reserved_units": {"value": 0},
        "substitution_available_units": {"value": 0},
        "safety_threshold_units": {"value": 1},
        "shelf_life_days": {"value": 42},
        "temp_c": {"value": 20},
        "is_holiday": {"value": 0},
        "dow": {"value": 1},
        "month": {"value": 1},
        "is_weekend": {"value": 0},
        "is_ice_storm": {"value": 0},
        "is_heat_wave": {"value": 0},
        "age_bucket_expiring_0_3d": {"value": 0},
        "age_bucket_expiring_4_7d": {"value": 0}
      },
      "prediction_value": {
        "path": "0.p_stockout_0_7d"
      },
      "result": {
        "entity_id_attr": "supply_id",
        "entity_type": "supply",
        "hospital_id_attr": "hospital.hospital_id",
        "blood_type_attr": "blood_product_type"
      },
      "alert": {
        "operator": ">=",
        "threshold": 0.5,
        "requires_hospital_scope": true
      },
      "alert_context": {
        "current_stock_units_attr": "current_stock_units",
        "usage_today_attr": "usage_today",
        "days_since_last_restock_attr": "days_since_last_restock"
      },
      "alert_source": "scheduled-inventory-risk-simulator"
    },
