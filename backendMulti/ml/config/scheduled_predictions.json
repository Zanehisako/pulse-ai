        "donor_momentum": ["donor_momentum"],
        "operational_outreach_priority": ["operational_outreach_priority"],
        "readiness_score": ["readiness_score"]
      },
      "binary_features": [
        "eligible_to_donate",
        "is_regular_donor",
        "is_rare_type"
      ]
    }
  },
  "jobs": [
