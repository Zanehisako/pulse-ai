    "history_days": 60,
    "alert_threshold": 3.0
  },
  "dashboard_forecast": {
    "cap_policy": {
      "enabled": true,
      "default_max_factor": 2.0,
      "min_floor_units": 50.0,
      "horizon_max_factors": {
        "t1": 2.0,
        "t7": 4.0,
        "t30": 8.0
      }
    }
  },
  "dashboard_snapshots": {
    "ideal": {
