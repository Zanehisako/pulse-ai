        {"model_id": "donor_priority_policy_model"},
        {"model_id": "donor_priority_policy_model_shadow"},
        {"identifier": "donor_priority_policy_model"}
      ],
      "fallback_filter": {
        "model_id__icontains": "donor_priority"
      },
      "field_aliases": {
        "blood_type": ["blood_type", "blood_group"],
        "eligible_to_donate": ["eligible_to_donate", "eligibility_status"],
        "is_regular_donor": ["is_regular_donor", "regularity"],
        "is_rare_type": ["is_rare_type", "rare_blood_type"],
