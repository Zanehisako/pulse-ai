{
  "_comment": [
    "Training Schedule Configuration",
    "================================",
    "Controls automated retraining of ML models for the current architecture.",
    "",
    "This file is embedded under backendMulti and is used by the Django ML layer.",
    "Training jobs themselves still execute the retained ml-backend training scripts.",
    "",
    "Each entry under 'scripts' maps a logical model name to:",
    "  script       : filename inside ml-backend/training_scripts/",
    "  frequency    : daily | weekly | monthly",
    "  time         : 'HH:MM' in 24-hour format — when the job fires",
    "  day_of_week  : mon|tue|wed|thu|fri|sat|sun  (weekly only)",
    "  day_of_month : 1-28                          (monthly only)",
    "  enabled      : true | false",
    "",
    "'defaults' apply when a script omits 'time' or 'timezone'.",
    "",
    "'post_training.sync_registry' controls whether the MLflow-to-Django",
    "registry sync runs automatically after every training batch."
  ],
  "defaults": {
    "time": "23:30",
    "timezone": "UTC"
  },
  "scripts": {
    "donor_next_donation_hazard": {
      "script": "train_donor_next_donation_hazard.py",
      "registered_model_name": "donor_next_donation_hazard_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "02:00",
      "enabled": true,
      "description": "Discrete-time hazard model for donor next-donation timing."
    },
    "donor_contact_propensity": {
      "script": "train_donor_contact_propensity.py",
      "registered_model_name": "donor_contact_propensity_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "02:10",
      "enabled": true,
      "description": "Donor contact propensity model."
    },
    "donor_priority_policy": {
      "script": "train_donor_priority_policy.py",
      "registered_model_name": "donor_priority_policy_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "02:20",
      "enabled": true,
      "description": "Expected-utility donor priority policy model."
    },
    "stockout_time_to_event_hazard": {
      "script": "train_stockout_time_to_event_hazard.py",
      "registered_model_name": "stockout_time_to_event_hazard_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "02:30",
      "enabled": true,
      "description": "Stockout time-to-event hazard sentinel model."
    },
    "component_demand_quantile_forecast": {
      "script": "train_component_demand_quantile_forecast.py",
      "registered_model_name": "component_demand_quantile_forecast_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "02:40",
      "enabled": true,
      "description": "Quantile demand forecast: P10/P50/P90."
    },
    "component_supply_forecast": {
      "script": "train_component_supply_forecast.py",
      "registered_model_name": "component_supply_forecast_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "02:50",
      "enabled": true,
      "description": "Probabilistic supply forecast: P10/P50/P90."
    },
    "component_expiry_waste": {
      "script": "train_component_expiry_waste.py",
      "registered_model_name": "component_expiry_waste_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "03:00",
      "enabled": true,
      "description": "Wastage forecast model. Feeds inventory simulator."
    },
    "component_inventory_risk_simulator": {
      "script": "train_component_inventory_risk_simulator.py",
      "registered_model_name": "component_inventory_risk_simulator",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "03:10",
      "enabled": true,
      "description": "Composite pyfunc inventory simulator. Primary stockout engine."
    },
    "donor_contact_response": {
      "script": "train_donor_contact_response.py",
      "registered_model_name": "donor_contact_response_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "03:20",
      "enabled": true,
      "description": "Contact response proxy model. Uplift claims not supported."
    },
    "donor_uplift": {
      "script": "train_donor_uplift.py",
      "registered_model_name": "donor_uplift_model",
      "frequency": "weekly",
      "day_of_week": "sun",
      "time": "03:30",
      "enabled": false,
      "description": "Causal uplift estimation placeholder. Disabled until randomized outreach holdout data exists."
    }
  },
  "post_training": {
    "sync_registry": true
  },
  "drift_monitoring": {
    "_comment": [
      "Drift Monitoring Configuration",
      "================================",
      "Controls automated drift detection for ML models.",
      "",
      "enabled          : master switch for scheduled drift checks",
      "frequency        : daily | weekly | monthly — how often to check",
      "time             : HH:MM when the drift check fires",
      "run_after_training: if true, a drift check also runs after each training job",
      "",
      "per_model overrides allow different schedules per model.",
      "Thresholds (psi_threshold, ks_threshold) control sensitivity.",
      "",
      "Results are logged to MLflow experiment 'model_drift_monitoring'",
      "and persisted to the Django DriftReport table."
    ],
    "enabled": true,
    "frequency": "daily",
    "time": "06:00",
    "run_after_training": true,
    "thresholds": {
      "psi": 0.2,
      "ks_pvalue": 0.05,
      "psi_warning": 0.1
    },
    "per_model": {
      "component_expiry_waste": {
        "enabled": true,
        "frequency": "weekly",
        "day_of_week": "mon",
        "time": "07:00"
      },
      "component_inventory_risk_simulator": {
        "enabled": true,
        "frequency": "weekly",
        "day_of_week": "mon",
        "time": "07:10"
      },
      "donor_contact_response": {
        "enabled": true,
        "frequency": "weekly",
        "day_of_week": "mon",
        "time": "07:20"
      }
    }
  },
  "promotion_rules": {
    "_comment": [
      "A/B testing gate: a newly trained 'challenger' model is promoted",
      "to 'champion' ONLY if it beats the current champion on the",
      "configured primary_metric.  direction is 'minimize' for error",
      "metrics (RMSE, MAE, loss) or 'maximize' for quality metrics",
      "(R², AUC, accuracy).  min_improvement_pct is the minimum %",
      "improvement required (0 = just match, 2 = must be 2% better).",
      "fallback_metrics are checked when the primary is unavailable."
    ],
    "default": {
      "primary_metric": "root_mean_squared_error",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "mean_absolute_error"
      ]
    },
    "donor_next_donation_hazard_model": {
      "primary_metric": "brier_score",
      "direction": "minimize",
      "min_improvement_pct": 2.0,
      "fallback_metrics": [
        "log_loss",
        "average_precision",
        "roc_auc"
      ]
    },
    "donor_contact_propensity_model": {
      "primary_metric": "brier_score",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "log_loss",
        "average_precision",
        "roc_auc"
      ]
    },
    "donor_priority_policy_model": {
      "primary_metric": "root_mean_squared_error",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "mean_absolute_error"
      ]
    },
    "stockout_time_to_event_hazard_model": {
      "primary_metric": "brier_score",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "log_loss",
        "average_precision",
        "roc_auc"
      ]
    },
    "component_demand_quantile_forecast_model": {
      "primary_metric": "rmsse",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "mase",
        "root_mean_squared_error"
      ]
    },
    "component_supply_forecast_model": {
      "primary_metric": "rmsse",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "mase",
        "root_mean_squared_error"
      ]
    },
    "component_expiry_waste_model": {
      "primary_metric": "root_mean_squared_error",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "mean_absolute_error",
        "mase"
      ]
    },
    "component_inventory_risk_simulator": {
      "primary_metric": "root_mean_squared_error",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "mean_absolute_error"
      ],
      "_note": "Simulator metrics TBD after first backtest. Promotion currently based on structural validation."
    },
    "donor_contact_response_model": {
      "primary_metric": "brier_score",
      "direction": "minimize",
      "min_improvement_pct": 0.0,
      "fallback_metrics": [
        "log_loss",
        "average_precision",
        "roc_auc"
      ]
    }
  }
}