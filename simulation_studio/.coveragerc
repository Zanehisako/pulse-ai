[run]
branch = True
relative_files = True
include =
    app/main.py
    app/schemas.py
    app/simulator_service.py
    app/studio_routes.py
    app/studio_service.py
    simulator/calibration.py
    simulator/core.py
    simulator/eval_metrics.py
    simulator/scenarios.py
omit =
    */tests/*
    */test_*.py
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[xml]
output = coverage.xml
