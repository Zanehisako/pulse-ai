{
  "id": "donor_next_donation_hazard_model",
  "name": "Donor Next-Donation Discrete-Time Hazard Model",
  "enabled": true,
  "type": "model",
  "input_schema": {
    "donor_id": "string",
    "event_timestamp": "datetime",
    "donor_features": "object"
  },
  "output_schema": {
    "prediction": "number",
    "p_donation_0_30d": "number",
    "p_donation_31_90d": "number",
    "p_donation_91_180d": "number",
    "p50_days_until_next_donation": "number_or_null",
    "median_status": "string"
  },
  "adapter": "mlflow_pyfunc",
  "entrypoint": "pios_ml_backend.survival.hazard_pyfunc.HazardModelPyfunc",
  "permissions": [
    "read_donor_profile",
    "read_donor_history",
    "write_shadow_prediction"
  ],
  "timeout_seconds": 30,
  "dataset_source": "quebec_donor",
  "model_type": "classification",
  "registered_model_name": "donor_next_donation_hazard_model",
  "description": "Discrete-time hazard model for donor next-donation timing. Builds interval dataset from days_until_next_donation labels, trains a tabular classifier ensemble on per-interval event prediction, and outputs horizon probabilities (0-30d, 31-90d, 91-180d, 181-365d) via survival curve conversion.",
  "target": {
    "column": "event_in_interval",
    "task_type": "classification",
    "output_name": "donation_probability",
    "event_column": "days_until_next_donation",
    "censored_value": 420,
    "intervals": [
      [0, 30],
      [31, 90],
      [91, 180],
      [181, 365]
    ]
  },
  "feature_engineering": {
    "group_columns": [
      "donor_id"
    ],
    "timestamp_column": "event_timestamp",
    "sequence_features": [
      "recency_days",
      "snapshot_days_until_eligible",
      "snapshot_overdue_days",
      "snapshot_frequency_365",
      "donation_count_last_12m",
      "donation_velocity",
      "readiness_score",
      "mobility_score",
      "travel_burden_score",
      "commitment_score",
      "response_readiness_index",
      "donor_momentum",
      "quebec_access_score",
      "emergency_outreach_priority"
    ],
    "lag_steps": [0],
    "static_features": [
      "age",
      "sex",
      "region",
      "city",
      "urbanicity",
      "language_preference",
      "blood_type",
      "is_rare_type",
      "blood_type_scarcity",
      "bmi",
      "smoker",
      "chronic_condition_flag",
      "center_distance_km",
      "travel_time_min",
      "route_feasibility_flag",
      "public_transit_access_score",
      "winter_route_risk_score",
      "digital_contactability_score",
      "area_deprivation_index",
      "eligible_to_donate",
      "is_regular_donor"
    ]
  },
  "training": {
    "include_default_classifiers": false,
    "forbidden_feature_groups": [
      "donor_outcome_proxy_scores"
    ],
    "threshold_optimization": {
      "enabled": true,
      "metric": "balanced_accuracy",
      "min_threshold": 0.05,
      "max_threshold": 0.85,
      "steps": 81
    },
    "classification_candidates": [
      {
        "name": "xgboost",
        "family": "xgboost",
        "params": {
          "n_estimators": 200,
          "max_depth": 6,
          "learning_rate": 0.03,
          "subsample": 0.85,
          "colsample_bytree": 0.75,
          "scale_pos_weight": 5,
          "objective": "binary:logistic",
          "random_state": 42
        }
      },
      {
        "name": "catboost",
        "family": "catboost",
        "params": {
          "iterations": 200,
          "depth": 7,
          "learning_rate": 0.03,
          "auto_class_weights": "Balanced",
          "loss_function": "Logloss",
          "eval_metric": "AUC",
          "random_seed": 42,
          "verbose": false
        }
      },
      {
        "name": "lightgbm",
        "family": "lightgbm",
        "params": {
          "n_estimators": 200,
          "learning_rate": 0.03,
          "num_leaves": 31,
          "class_weight": "balanced",
          "random_state": 42,
          "n_jobs": 4,
          "verbosity": -1
        }
      },
      {
        "name": "random_forest",
        "family": "random_forest",
        "params": {
          "n_estimators": 200,
          "min_samples_leaf": 2,
          "class_weight": "balanced_subsample",
          "random_state": 42,
          "n_jobs": 4
        }
      }
    ],
    "ensemble": {
      "enabled": true,
      "name": "donor_hazard_tabular_ensemble",
      "weighting": "validation_brier",
      "min_members": 3
    }
  },
  "selection": {
    "primary_metric": "brier_score",
    "direction": "minimize",
    "fallback_metrics": [
      "log_loss",
      "average_precision",
      "roc_auc"
    ]
  },
  "prediction_defaults": {
    "forecast_selection": {
      "enabled": true,
      "target": "donation",
      "primary_metric": "brier_score",
      "direction": "minimize",
      "fallback_metrics": [
        "log_loss",
        "average_precision",
        "roc_auc"
      ]
    },
    "horizon_routing": {
      "enabled": true,
      "timeframes": ["short", "medium", "long"],
      "min_days": 0,
      "max_days": 365,
      "priority": 150,
      "label": "unified donor next-donation hazard model (replaces separate horizon classifiers)",
      "target": "donation"
    },
    "output": {
      "name": "donation_probability",
      "unit": "probability",
      "task_type": "classification",
      "clip_min": 0.0,
      "clip_max": 1.0,
      "apply_clipping": true
    }
  },
  "explainability": {
    "shap": {
      "enabled": true,
      "sample_rows": 32,
      "background_rows": 64
    }
  }
}
