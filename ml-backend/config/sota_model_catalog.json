        "collection_30d_mean",
        "stockout_count_30d"
      ],
      "description": "Predicts future blood demand (units needed) per hospital, blood type, and component over 7/30 day horizons. Use for demand forecasting and supply planning.",
      "examples": [
        {
          "kind": "good",
          "user_query": "Forecast demand units for O+ red cells at hospital H001 over the next week.",
          "why": "Direct inventory demand forecasting."
        },
        {
          "kind": "good",
          "user_query": "How many units of A- plasma will be needed next month?",
          "why": "Demand quantity prediction."
        },
        {
          "kind": "bad",
          "user_query": "Can this donor donate blood?",
          "why": "Donor eligibility is not demand forecasting."
        }
