{
  "id": "component_expiry_waste_model",
  "name": "Component Expiry Waste Forecast",
  "enabled": true,
  "type": "model",
  "input_schema": {
    "hospital_id": "string",
    "blood_type": "string",
    "component_type": "string",
    "event_timestamp": "datetime",
    "expiry_features": "object"
  },
  "output_schema": {
    "wastage_units": "number",
    "prediction": "number"
  },
  "adapter": "mlflow_pyfunc",
  "entrypoint": "training_scripts.train_component_expiry_waste",
  "permissions": [
    "read_inventory_state",
    "read_inventory_history",
    "read_waste_forecast",
    "write_shadow_prediction"
  ],
  "timeout_seconds": 30,
  "model_type": "regression",
  "registered_model_name": "component_expiry_waste_model",
  "description": "Daily wastage forecast by hospital, component, and blood type. Handles known expiry deterministically and uncertain waste probabilistically. Primary target: wastage_next_1d. Extended targets: wastage_next_7d, wastage_next_30d. Report-only when shifted labels unavailable.",
  "target": {
    "column": "wastage_next_1d",
    "task_type": "regression",
    "output_name": "wastage_units",
    "fallback_targets": ["wastage"],
    "report_only_fallback": true
  },
  "feature_engineering": {
    "group_columns": [
      "hospital_id",
      "blood_type",
      "component_type"
    ],
    "timestamp_column": "event_timestamp",
    "key_wastage_features": [
      "current_inventory",
      "component_shelf_life_days",
      "is_heat_wave",
      "usage_today",
      "inventory_7d_mean",
      "inventory_30d_mean",
      "usage_7d_mean",
      "usage_30d_mean",
      "wastage_7d_mean",
      "wastage_30d_mean",
      "inventory_trend_7d",
      "days_of_inventory_on_hand",
      "component_criticality_score"
    ]
  },
  "forecast_outputs": {
    "horizons_days": [1, 7, 30],
    "quantiles": [0.5]
  },
  "training": {
    "include_default_regressors": true,
    "forbidden_feature_groups": [
      "stockout_same_row_risk_scores"
    ],
    "selection": {
      "primary_metric": "root_mean_squared_error",
      "direction": "minimize",
      "fallback_metrics": [
        "mean_absolute_error",
        "rmsse",
        "mase"
      ]
    }
  },
  "report_only": false,
  "data_availability_note": "Uses shifted labels (wastage_next_1d/7d/30d) computed from grouped historical wastage patterns. Falls back to same-row wastage as proxy target if shifted labels contain only NaN for all groups.",
  "prediction_defaults": {
    "forecast_selection": {
      "enabled": true,
      "target": "wastage",
      "primary_metric": "root_mean_squared_error",
      "direction": "minimize",
      "fallback_metrics": [
        "mean_absolute_error",
        "mase"
      ]
    },
    "horizon_routing": {
      "enabled": false
    },
    "output": {
      "name": "wastage_units",
      "unit": "units",
      "task_type": "regression",
      "clip_min": 0.0,
      "apply_clipping": true
    }
  }
}
