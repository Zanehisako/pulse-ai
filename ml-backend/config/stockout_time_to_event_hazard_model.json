{
  "id": "stockout_time_to_event_hazard_model",
  "name": "Stockout Time-to-Event Hazard Sentinel",
  "enabled": true,
  "type": "model",
  "input_schema": {
    "hospital_id": "string",
    "blood_type": "string",
    "component_type": "string",
    "event_timestamp": "datetime",
    "inventory_features": "object"
  },
  "output_schema": {
    "prediction": "number",
    "p_stockout_0_7d": "number",
    "p_stockout_8_30d": "number",
    "p_stockout_31_60d": "number",
    "p50_days_until_stockout": "number_or_null",
    "median_status": "string"
  },
  "adapter": "mlflow_pyfunc",
  "entrypoint": "pios_ml_backend.survival.hazard_pyfunc.HazardModelPyfunc",
  "permissions": [
    "read_inventory_state",
    "read_inventory_history",
    "write_shadow_prediction"
  ],
  "timeout_seconds": 30,
  "dataset_source": "quebec_inventory",
  "model_type": "classification",
  "registered_model_name": "stockout_time_to_event_hazard_model",
  "description": "Discrete-time hazard model for hospital inventory stockout timing. Sentinel model that produces calibrated stockout horizon probabilities. Used alongside direct classifiers for disagreement detection, not as the primary production stockout engine.",
  "target": {
    "column": "event_in_interval",
    "task_type": "classification",
    "output_name": "stockout_probability",
    "event_column": "days_until_stockout",
    "censored_value": 60,
    "intervals": [
      [0, 7],
      [8, 30],
      [31, 60]
    ]
  },
  "feature_engineering": {
    "group_columns": [
      "hospital_id",
      "blood_type",
      "component_type"
    ],
    "timestamp_column": "event_timestamp",
    "static_features": [
      "hospital_size_tier",
      "blood_type",
      "component_type",
      "component_criticality_score",
      "blood_type_scarcity"
    ]
  },
  "training": {
    "max_sample_rows": 15000,
    "include_default_classifiers": false,
    "forbidden_feature_groups": [
      "stockout_same_row_risk_scores"
    ],
    "threshold_optimization": {
      "enabled": true,
      "metric": "balanced_accuracy",
      "min_threshold": 0.05,
      "max_threshold": 0.85,
      "steps": 81
    },
    "classification_candidates": [
      {
        "name": "xgboost",
        "family": "xgboost",
        "params": {
          "n_estimators": 200,
          "max_depth": 6,
          "learning_rate": 0.03,
          "subsample": 0.85,
          "colsample_bytree": 0.75,
          "scale_pos_weight": 2,
          "objective": "binary:logistic",
          "random_state": 42
        }
      },
      {
        "name": "catboost",
        "family": "catboost",
        "params": {
          "iterations": 200,
          "depth": 7,
          "learning_rate": 0.03,
          "auto_class_weights": "Balanced",
          "loss_function": "Logloss",
          "random_seed": 42,
          "verbose": false
        }
      },
      {
        "name": "lightgbm",
        "family": "lightgbm",
        "params": {
          "n_estimators": 200,
          "learning_rate": 0.03,
          "num_leaves": 31,
          "class_weight": "balanced",
          "random_state": 42,
          "n_jobs": 4,
          "verbosity": -1
        }
      }
    ],
    "ensemble": {
      "enabled": true,
      "name": "stockout_hazard_tabular_ensemble",
      "weighting": "validation_brier",
      "min_members": 2
    }
  },
  "selection": {
    "primary_metric": "brier_score",
    "direction": "minimize",
    "fallback_metrics": [
      "log_loss",
      "average_precision",
      "roc_auc"
    ]
  },
  "prediction_defaults": {
    "forecast_selection": {
      "enabled": true,
      "target": "stockout",
      "primary_metric": "brier_score",
      "direction": "minimize",
      "fallback_metrics": [
        "log_loss",
        "average_precision",
        "roc_auc"
      ]
    },
    "horizon_routing": {
      "enabled": true,
      "timeframes": ["short", "medium"],
      "min_days": 0,
      "max_days": 30,
      "priority": 100,
      "label": "stockout time-to-event hazard sentinel (complements direct classifiers)",
      "target": "stockout"
    },
    "output": {
      "name": "stockout_probability",
      "unit": "probability",
      "task_type": "classification",
      "clip_min": 0.0,
      "clip_max": 1.0,
      "apply_clipping": true
    }
  }
}
